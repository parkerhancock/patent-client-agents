{
  "name": "@patent-client-agents/mcp",
  "version": "0.1.0",
  "description": "MCP server for patent-client-agents: createServer() returns a FastMCP server with the full or curated patent toolset.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parkerhancock/patent-client-agents.git",
    "directory": "typescript/packages/mcp"
  },
  "homepage": "https://github.com/parkerhancock/patent-client-agents/tree/main/typescript",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./gcs-blob-store": {
      "types": "./dist/gcs-blob-store.d.ts",
      "bun": "./src/gcs-blob-store.ts",
      "default": "./dist/gcs-blob-store.js"
    }
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "prepack": "tsc -b --force"
  },
  "dependencies": {
    "@patent-client-agents/client": "workspace:^",
    "@prefecthq/fastmcp-ts": "1.7.3",
    "fflate": "0.8.3",
    "zod": "4.3.6",
    "@patent-client-agents/waf-session": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
