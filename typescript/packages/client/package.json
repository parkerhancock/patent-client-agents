{
  "name": "@patent-client-agents/client",
  "version": "0.1.0",
  "description": "Typed TypeScript clients for patent, trademark and IP-law data sources (USPTO, EPO, WIPO and more). Runs in Bun, Node and browsers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parkerhancock/patent-client-agents.git",
    "directory": "typescript/packages/client"
  },
  "homepage": "https://github.com/parkerhancock/patent-client-agents/tree/main/typescript",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./corpus-bootstrap": {
      "types": "./dist/corpus/bootstrap.d.ts",
      "bun": "./src/corpus/bootstrap.ts",
      "default": "./dist/corpus/bootstrap.js"
    }
  },
  "scripts": {
    "prepack": "tsc -b --force"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "entities": "8.1.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "http-cache-semantics": "4.3.0",
    "ky": "2.2.0",
    "linkedom": "0.18.13",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "zod": "4.3.6"
  },
  "imports": {
    "#files": {
      "types": "./src/runtime/files.ts",
      "browser": {
        "bun": "./src/runtime/files.browser.ts",
        "default": "./dist/runtime/files.browser.js"
      },
      "bun": "./src/runtime/files.ts",
      "default": "./dist/runtime/files.js"
    },
    "#cache-sqlite": {
      "types": "./src/runtime/cache-sqlite.ts",
      "browser": {
        "bun": "./src/runtime/cache-sqlite.browser.ts",
        "default": "./dist/runtime/cache-sqlite.browser.js"
      },
      "bun": "./src/runtime/cache-sqlite.ts",
      "default": "./dist/runtime/cache-sqlite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
