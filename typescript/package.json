{
  "name": "patent-client-agents-typescript",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "record:odp": "bun scripts/record-odp.ts --record",
    "replay:odp": "bun scripts/record-odp.ts --replay",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun test",
    "record:uspto": "bun scripts/record-uspto.ts --record",
    "replay:uspto": "bun scripts/record-uspto.ts --replay",
    "record:applications": "bun scripts/record-application-features.ts --record",
    "replay:applications": "bun scripts/record-application-features.ts --replay",
    "record:bulk-file": "bun scripts/record-bulk-file.ts --record",
    "record:application-get": "bun scripts/record-application-get.ts --record",
    "replay:application-get": "bun scripts/record-application-get.ts --replay",
    "record:record-features": "bun scripts/record-record-features.ts --record",
    "replay:record-features": "bun scripts/record-record-features.ts --replay",
    "record:office-actions": "bun scripts/record-office-action-features.ts --record",
    "replay:office-actions": "bun scripts/record-office-action-features.ts --replay",
    "record:tsdr": "bun scripts/record-tsdr-features.ts --record",
    "replay:tsdr": "bun scripts/record-tsdr-features.ts --replay",
    "record:ptab-pdf": "bun scripts/record-ptab-pdf.ts --record",
    "record:trademark-search": "bun scripts/record-trademark-search.ts",
    "waf:refresh": "bun packages/waf-worker/src/cli.ts",
    "waf:install-browser": "bun run --filter @patent-client-agents/waf-worker install:browser",
    "verify:waf": "bun scripts/verify-waf-worker.ts",
    "verify:mpep": "bun scripts/verify-mpep.ts",
    "verify:epo-legal": "bun scripts/verify-epo-legal.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@patent-client-agents/client": "workspace:*",
    "@patent-client-agents/mcp": "workspace:*",
    "@prefecthq/fastmcp-ts": "1.7.3",
    "@types/bun": "1.4.3",
    "cassetter": "0.11.0",
    "fflate": "0.8.3",
    "ky": "2.2.0",
    "typescript": "5.9.3",
    "zod": "4.3.6",
    "@patent-client-agents/waf-session": "workspace:*",
    "@patent-client-agents/waf-worker": "workspace:*"
  }
}
