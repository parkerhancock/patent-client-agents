{
  "name": "patent-client-agents-typescript",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "record:odp": "bun scripts/record-odp.ts --record",
    "replay:odp": "bun scripts/record-odp.ts --replay",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun test && bun run smoke:node && bun run smoke:browser",
    "smoke:node": "node scripts/smoke-node.mjs",
    "smoke:browser": "bun scripts/smoke-browser.ts",
    "record:uspto": "bun scripts/record-uspto.ts --record",
    "replay:uspto": "bun scripts/record-uspto.ts --replay",
    "record:applications": "bun scripts/record-application-features.ts --record",
    "replay:applications": "bun scripts/record-application-features.ts --replay",
    "record:bulk-file": "bun scripts/record-bulk-file.ts --record",
    "record:application-get": "bun scripts/record-application-get.ts --record",
    "replay:application-get": "bun scripts/record-application-get.ts --replay",
    "record:record-features": "bun scripts/record-record-features.ts --record",
    "replay:record-features": "bun scripts/record-record-features.ts --replay",
    "record:office-actions": "bun scripts/record-office-action-features.ts --record",
    "replay:office-actions": "bun scripts/record-office-action-features.ts --replay",
    "record:tsdr": "bun scripts/record-tsdr-features.ts --record",
    "replay:tsdr": "bun scripts/record-tsdr-features.ts --replay",
    "record:ptab-pdf": "bun scripts/record-ptab-pdf.ts --record",
    "record:trademark-search": "bun scripts/record-trademark-search.ts",
    "waf:refresh": "bun packages/waf-worker/src/cli.ts",
    "waf:install-browser": "bun run --filter @patent-client-agents/waf-worker install:browser",
    "verify:waf": "bun scripts/verify-waf-worker.ts",
    "verify:mpep": "bun scripts/verify-mpep.ts",
    "record:epo-ops": "bun scripts/record-epo-ops.ts",
    "record:cafc": "bun scripts/record-cafc.ts",
    "record:canada-federal-court": "bun scripts/record-canada-federal-court.ts",
    "record:japan-ip-high-court": "bun scripts/record-japan-ip-high-court.ts",
    "record:china-spc-ip-court": "bun scripts/record-china-spc-ip-court.ts",
    "record:kipris": "bun scripts/record-kipris.ts",
    "record:copyright": "bun scripts/record-copyright.ts",
    "record:usitc": "bun scripts/record-usitc.ts",
    "record:wipo-lex": "bun scripts/record-wipo-lex.ts",
    "record:fees": "bun scripts/record-fees.ts",
    "record:google-patents": "bun scripts/record-google-patents.ts",
    "verify:facade-live": "bun scripts/live-facade.ts",
    "verify:epo-legal": "bun scripts/verify-epo-legal.ts",
    "verify:upc-statutes": "bun scripts/verify-upc-statutes.ts",
    "build:dpma-statutes": "bun scripts/build-dpma-statutes-corpus.ts",
    "verify:dpma-statutes": "bun scripts/verify-dpma-statutes.ts",
    "build:ilpo-statutes": "bun scripts/build-ilpo-statutes-corpus.ts",
    "verify:ilpo-statutes": "bun scripts/verify-ilpo-statutes.ts",
    "verify:tmep": "bun scripts/verify-tmep.ts",
    "verify:ukipo-mopp": "bun scripts/verify-ukipo-mopp.ts",
    "verify:ipo-in": "bun scripts/verify-ipo-in.ts",
    "build:ipo-in": "bun scripts/build-ipo-in-corpora.ts",
    "fetch:ipo-in": "bun scripts/build-ipo-in-corpora.ts --fetch",
    "build:ipos": "bun scripts/build-ipos-corpora.ts",
    "fetch:ipos": "bun scripts/build-ipos-corpora.ts --fetch",
    "verify:ipos": "bun scripts/verify-ipos.ts",
    "start:hosted": "bun packages/hosted/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@patent-client-agents/client": "workspace:*",
    "@patent-client-agents/hosted": "workspace:*",
    "@patent-client-agents/mcp": "workspace:*",
    "@patent-client-agents/waf-session": "workspace:*",
    "@patent-client-agents/waf-worker": "workspace:*",
    "@prefecthq/fastmcp-ts": "1.7.3",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "cassetter": "0.11.0",
    "fflate": "0.8.3",
    "ky": "2.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  }
}
